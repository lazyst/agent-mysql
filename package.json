    "commander": "^14.0.3",
    "mysql2": "^3.22.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
