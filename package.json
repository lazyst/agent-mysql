{
  "name": "agent-mysql",
  "version": "1.0.0",
  "description": "MySQL CLI tool designed for AI Agents",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-mysql": "bin/agent-mysql.js"
  },
  "scripts": {
    "dev": "tsup --watch",
